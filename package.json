{
  "name": "arr-mcp-server",
  "version": "1.1.0",
  "mcpName": "arr-media-stack",
  "description": "MCP server for managing a self-hosted media stack (Radarr, Sonarr, qBittorrent, Plex, Overseerr)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "arr-mcp-server": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexscdt/arr-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/alexscdt/arr-mcp-server/issues"
  },
  "homepage": "https://github.com/alexscdt/arr-mcp-server#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "radarr",
    "sonarr",
    "plex",
    "plex-server",
    "qbittorrent",
    "overseerr",
    "homelab",
    "media-server",
    "automation",
    "self-hosted",
    "arr-stack"
  ],
  "author": "alexscdt",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
